#!/usr/bin/env bash
# Refuses a push when the project's checks fail.
root=$(git rev-parse --show-toplevel)
[ -x "$root/scripts/check.sh" ] || exit 0

# CI=1 makes the format step check only: the commits being pushed cannot be
# fixed by rewriting the working tree, so unformatted code must fail here.
echo "pre-push: running scripts/check.sh"
if ! CI=1 "$root/scripts/check.sh"; then
  echo "pre-push: checks failed, push refused." >&2
  exit 1
fi
