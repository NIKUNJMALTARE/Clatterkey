{
	"name": "clatterkey",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"tauri": "tauri",
		"test": "vitest run",
		"keys": "cargo run --manifest-path src-tauri/Cargo.toml --example keys",
		"make-packs": "cargo run --manifest-path src-tauri/Cargo.toml --example make-packs",
		"make-app-icons": "scripts/make-app-icons.sh",
		"make-tray-icons": "cargo run --manifest-path src-tauri/Cargo.toml --example make-tray-icons",
		"prepare": "node scripts/prepare.mjs"
	},
	"dependencies": {
		"@tauri-apps/api": "~2.12.5",
		"react": "~19.3.1",
		"react-dom": "~19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.6.8",
		"@tauri-apps/cli": "~2.12.6",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "~16.3.3",
		"@types/react": "~19.3.0",
		"@types/react-dom": "~19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"jsdom": "^31.0.1",
		"typescript": "~7.0.2",
		"vite": "~8.3.8",
		"vitest": "~5.1.1",
		"yaml": "^2.9.1"
	}
}
