{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mechanical Key Sounds",
  "version": "0.1.0",
  "identifier": "com.mechanicalkeysounds.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mechanical Key Sounds",
        "width": 420,
        "height": 560,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/packs/"
    ]
  }
}
